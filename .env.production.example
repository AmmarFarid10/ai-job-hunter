# Copy to .env.production; never commit the populated file.
# Generate URL-safe secrets: python -c 'import secrets; print(secrets.token_urlsafe(48))'
ENVIRONMENT=production
APP_DOMAIN=jobs.example.com
ACME_EMAIL=operator@example.com
DASHBOARD_URL=https://jobs.example.com
GOOGLE_REDIRECT_URI=https://jobs.example.com/api/oauth/google/callback
API_KEY=replace-with-generated-private-maintenance-secret
GATEWAY_TOKEN=replace-with-generated-private-gateway-secret
POSTGRES_PASSWORD=replace-with-generated-url-safe-database-password
REQUIRE_EMAIL_VERIFICATION=true
ALLOW_API_KEY_AUTH=false
ALLOW_ADMIN_BOOTSTRAP=false
# Configure a real transactional SMTP provider. TLS certificate checks are mandatory.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_TLS=starttls
SMTP_USERNAME=replace-with-provider-username
SMTP_PASSWORD=replace-with-provider-password
AUTH_SENDER_EMAIL=no-reply@jobs.example.com
# Set only for explicit one-time administrator initialization; remove afterward.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-private-initial-password
NOTIFICATION_MODE=mock
SCHEDULER_ENABLED=true
DAILY_AUTH_MAIL_LIMIT=500
GLOBAL_DAILY_DISCOVERY_LIMIT=100
GLOBAL_MONTHLY_DISCOVERY_LIMIT=1000
DAILY_DISCOVERY_LIMIT=20
DAILY_GENERATION_LIMIT=30
DAILY_UPLOAD_LIMIT=20
DAILY_MATCHING_LIMIT=100
DAILY_REPORT_LIMIT=10
MAX_CANDIDATES_PER_USER=10
# Optional external integrations; all remain server-side.
# TAVILY_API_KEY=
# BRAVE_API_KEY=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# OPENAI_API_KEY=
# OPENAI_EXTRACTION_MODEL=
