API_KEY=replace-with-a-random-secret-at-least-32-characters
DATABASE_URL=postgresql+asyncpg://jobhunter:localdev@localhost:5432/jobhunter
STORAGE_DIR=./storage
MAX_UPLOAD_BYTES=10485760
MATCH_THRESHOLD=80

# Phase 2. Missing source config defaults to mock only.
DISCOVERY_CONFIG_FILE=discovery_sources.json
DISCOVERY_TIMEOUT_SECONDS=90
# Optional server-only credentials. Never include them in API requests.
# BRAVE_API_KEY=
# GMAIL_TOKEN_FILE=/run/secrets/gmail_token.json
# TAVILY_API_KEY=

# Phase 3 matching defaults to deterministic rules; no LLM credentials needed.
MATCHING_TIMEOUT_SECONDS=90
# Optional extraction only, explicitly requested with extractor="openai":
# OPENAI_API_KEY=
# OPENAI_EXTRACTION_MODEL=

# Phase 5: mock mode never sends external messages. Enable candidate settings in dashboard.
NOTIFICATION_MODE=mock
SCHEDULER_ENABLED=true
DASHBOARD_URL=http://localhost:3000
# Live Gmail requires a separate authorized-user OAuth file with gmail.send scope,
# private permissions (0600), and client_id/client_secret/refresh_token.
# GMAIL_SEND_TOKEN_FILE=/run/secrets/gmail_send.json
# GMAIL_SENDER_EMAIL=your-authorized-sender@example.com
# WhatsApp requires an opted-in recipient and approved two-body-parameter template.
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_GRAPH_VERSION=  # Set a currently supported Meta Graph API version.
# WHATSAPP_TEMPLATE_NAME=job_hunter_report
# WHATSAPP_TEMPLATE_LANGUAGE=en_US

# Optional Google signup/login (Web application OAuth client; not Gmail sending credentials).
# GOOGLE_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-web-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/oauth/google/callback

# Optional one-time administrator initialization: python -m app.admin
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=choose-a-private-password-at-least-12-characters
