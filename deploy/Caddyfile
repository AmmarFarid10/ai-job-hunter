{
	email {$ACME_EMAIL}
	servers {
		timeouts {
			read_body 30s
			read_header 10s
		}
	}
}
{$APP_DOMAIN} {
	encode zstd gzip
	request_body {
		max_size 12MB
	}
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"
	header -Server
	# Do not enable access logs containing OAuth codes, request paths or identifiers.
	reverse_proxy dashboard:3000 {
		health_uri /api/session
		health_interval 30s
		health_timeout 5s
		health_status 200
	}
}
